{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "dev": "tsx watch --include ../../packages/shared/dist/**/*.js src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@frameroom/shared": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.157",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
