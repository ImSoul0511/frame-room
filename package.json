{
  "name": "frameroom",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @frameroom/shared build && pnpm --filter web dev",
    "dev:api": "pnpm --filter @frameroom/shared build && pnpm --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "pnpm --filter @frameroom/shared build",
    "pretest": "pnpm --filter @frameroom/shared build",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:types": "node scripts/db-types.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
